{
    "name": "@nyar/jvm",
    "version": "0.1.0",
    "description": "JVM class and jar inspection with Node-API bindings.",
    "type": "module",
    "license": "MIT",
    "main": "./dist/index.js",
    "exports": {
        ".": "./dist/index.js",
        "./cli": "./dist/cli/cli.js"
    },
    "bin": {
        "jvm": "bin/jvm.js"
    },
    "files": [
        "bin",
        "dist",
        "locales",
        "src",
        "readme.md",
        "README.md"
    ],
    "scripts": {
        "build": "node ../../../../scripts/strip-types.mjs projects/ts/emulators/jvm",
        "prepare": "node ../../../../scripts/strip-types.mjs projects/ts/emulators/jvm",
        "prepack": "node ../../../../scripts/strip-types.mjs projects/ts/emulators/jvm && node ../../../../scripts/prepare-npm-publish.mjs",
        "test": "node --experimental-strip-types --test tests/**/*.test.ts"
    },
    "dependencies": {
        "@vmz/commander": "^0.3.5",
        "@vmz/diagnostic": "^0.3.5"
    },
    "optionalDependencies": {
        "@nyar/jvm-darwin-arm64": "workspace:*",
        "@nyar/jvm-darwin-x64": "workspace:*",
        "@nyar/jvm-linux-x64": "workspace:*",
        "@nyar/jvm-win32-x64": "workspace:*"
    },
    "engines": {
        "node": ">=22.18.0"
    },
    "keywords": [
        "jvm",
        "class-file",
        "jar",
        "bytecode"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nyar-vm/jvm.git",
        "directory": "projects/ts/emulators/jvm"
    },
    "publishConfig": {
        "access": "public"
    }
}
